<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Smart SPT Logger</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f2f4f7;
            color: #222;
        }

        .header {
            background: #1f2937;
            color: white;
            text-align: center;
            padding: 25px 15px;
        }

        .header h1 {
            margin: 0;
            font-size: 28px;
        }

        .header p {
            margin: 8px 0 0;
            font-size: 15px;
        }

        .container {
            max-width: 900px;
            margin: 30px auto;
            padding: 15px;
        }

        .status {
            text-align: center;
            background: white;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .status span {
            font-weight: bold;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .card h2 {
            margin: 0 0 12px;
            font-size: 18px;
            color: #555;
        }

        .value {
            font-size: 38px;
            font-weight: bold;
        }

        .unit {
            font-size: 17px;
            color: #666;
        }

        .nvalue {
            grid-column: span 2;
        }

        .nvalue .value {
            font-size: 55px;
        }

        .footer {
            text-align: center;
            margin-top: 25px;
            color: #666;
            font-size: 13px;
        }

        @media (max-width: 600px) {
            .grid {
                grid-template-columns: 1fr;
            }

            .nvalue {
                grid-column: span 1;
            }
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>SMART SPT LOGGER</h1>
        <p>Real-Time Standard Penetration Test Monitoring</p>
    </div>

    <div class="container">

        <div class="status">
            Status:
            <span id="status">Connecting...</span>
        </div>

        <div class="grid">

            <div class="card">
                <h2>DEPTH</h2>
                <div class="value" id="depth">0</div>
                <div class="unit">cm</div>
            </div>

            <div class="card">
                <h2>HAMMER BLOWS</h2>
                <div class="value" id="blows">0</div>
                <div class="unit">blows</div>
            </div>

            <div class="card">
                <h2>N1</h2>
                <div class="value" id="n1">0</div>
                <div class="unit">blows</div>
            </div>

            <div class="card">
                <h2>N2</h2>
                <div class="value" id="n2">0</div>
                <div class="unit">blows</div>
            </div>

            <div class="card nvalue">
                <h2>N-VALUE</h2>
                <div class="value" id="nvalue">0</div>
                <div class="unit">N</div>
            </div>

        </div>

        <div class="footer">
            Smart SPT Logger | Mining Engineering Project
            <br>
            Last update: <span id="updated">--</span>
        </div>

    </div>

    <script>

        /*
         * IMPORTANT:
         * Put your Cloudflare Worker URL below.
         *
         * Example:
         * https://smart-spt-api.username.workers.dev
         */

        const API_URL = "YOUR_CLOUDFLARE_WORKER_URL";

        async function updateDashboard() {

            try {

                const response = await fetch(API_URL);

                if (!response.ok) {
                    throw new Error("Server error");
                }

                const data = await response.json();

                document.getElementById("depth").textContent =
                    data.depth;

                document.getElementById("blows").textContent =
                    data.blows;

                document.getElementById("n1").textContent =
                    data.n1;

                document.getElementById("n2").textContent =
                    data.n2;

                document.getElementById("nvalue").textContent =
                    data.nvalue;

                document.getElementById("status").textContent =
                    data.status;

                document.getElementById("updated").textContent =
                    new Date().toLocaleTimeString();

            }

            catch (error) {

                console.log(error);

                document.getElementById("status").textContent =
                    "Connection Error";

            }
        }

        updateDashboard();

        // Update every 2 seconds
        setInterval(updateDashboard, 2000);

    </script>

</body>
</html>
